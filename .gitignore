# Build output
target/*
# Anchor IDLs are committed so CI can run the client tests without building programs
!target/idl/
target/idl/*
!target/idl/*.json
tests-graduation/target/
client/node_modules/
client/dist/

# Secrets and keys: never commit
.env
.env.*
*.key
*keypair*.json
id.json
helius-key.txt
pyth-key.txt
test-trading-accounts/

# Local runtime data
*.log
client/metadata-store/
sponsor-state.json
sponsor-state.json.lock
devnet-deployment.json

# Raw third-party market data (GeckoTerminal); fetch it with the collector script
sim/data/launch-data.json

# Python
__pycache__/
*.pyc
tests/target/
